rules_version = '2';

// Firestore rules for the "singularitythegame" project.
//
// This project holds ONLY auth + game data. Hosting for the game is owned by
// the WesleyArcadeSite repo (project singularity-c216f), which serves the
// built files at wesleyarcade.com/singularity/. Nothing here is deployed by
// that repo, and nothing there is deployed by this one -- that separation is
// the whole point of the split.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidName(name) {
      return name is string && name.size() >= 1 && name.size() <= 32;
    }

    // Player profiles. Readable by anyone because the leaderboard renders
    // display names next to scores.
    match /users/{uid} {
      allow read: if true;

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && isValidName(request.resource.data.displayName)
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && isValidName(request.resource.data.displayName)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(uid);
    }

    // Leaderboard entries, one per completed run.
    //
    // A survival score, not a time. The run clock was removed from the game --
    // this is about how far you get and what you have left when you stop, not
    // how fast you got there -- so a run is ranked by levels cleared, then by
    // craft still in hand as the tiebreak.
    //
    // Append-only: a run either happened or it did not, so nothing may edit or
    // remove it afterwards.
    match /scores/{scoreId} {
      allow read: if true;

      allow create: if isOwner(request.resource.data.uid)
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'levelsCleared', 'craftRemaining', 'craftId', 'createdAt'])
        && isValidName(request.resource.data.displayName)
        && request.resource.data.levelsCleared is int
        && request.resource.data.levelsCleared >= 0
        // Bounded well above the current campaign so adding levels does not
        // require a rules deploy, but low enough to reject a fabricated number.
        && request.resource.data.levelsCleared <= 50
        && request.resource.data.craftRemaining is int
        && request.resource.data.craftRemaining >= 0
        && request.resource.data.craftRemaining <= 3
        && request.resource.data.craftId is string
        && request.resource.data.craftId.size() <= 32
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // Anything not matched above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
